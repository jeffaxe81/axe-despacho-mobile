# Development proxy only (example). Keep HTTP access limited to a local dev backend.
# Production web must be deployed under the SAME HTTPS ORIGIN as the central API.
VITE_DISPATCH_DEV_PROXY=http://127.0.0.1:3000

# Do not enable a cross-origin mobile URL with the existing cookie auth.
# Native authentication will require a dedicated, approved backend contract.
# VITE_DISPATCH_API_BASE=https://central.example.com
