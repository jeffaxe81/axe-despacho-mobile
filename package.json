{
  "name": "axe-despacho-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:readiness": "node --test scripts/mobile-readiness.nodecheck.mjs",
    "readiness:mobile": "node scripts/mobile-readiness.mjs",
    "test:1000": "vitest run src/lib/robustness1000.test.ts",
    "preview": "vite preview",
    "native:sync": "npm run build && cap sync",
    "native:android": "npm run native:sync && cap open android",
    "native:ios": "npm run native:sync && cap open ios",
    "android:verify": "node scripts/android/verify-generated.mjs",
    "android:install-lab": "node scripts/android/install-location-lab.mjs",
    "android:debug": "npm run build && npx cap add android && npx cap sync android && npm run android:install-lab && npm run android:verify && cd android && ./gradlew assembleDebug",
    "test:2000": "vitest run src/lib/mobileHomologation2000a.test.ts src/lib/mobileHomologation2000b.test.ts",
    "test:10m:shard": "vitest run --config vitest.10m.config.ts"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/geolocation": "8.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "superjson": "^2.2.2",
    "@capacitor/app": "8.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
